### 1. 初始化上传会话（请按测试文件修改大小、分片数和 MD5）
# @name beginUpload
POST http://localhost:8000/api/images/uploads
Content-Type: application/json

{
  "fileName": "test_image.tif",
  "fileSize": 1024,
  "chunkSize": 1024,
  "totalChunks": 1,
  "fileHash": "00000000000000000000000000000000"
}

### 2. 上传分片
PUT http://localhost:8000/api/images/uploads/{{beginUpload.response.body.$.data.uploadId}}/chunks/0
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="chunk"; filename="0.part"
Content-Type: application/octet-stream

< ./path/to/your/image.tif
--Boundary--

### 3. 完成创建
POST http://localhost:8000/api/images
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="uploadId"

{{beginUpload.response.body.$.data.uploadId}}
--Boundary
Content-Disposition: form-data; name="imageName"

小明图
--Boundary
Content-Disposition: form-data; name="resolution"

1
--Boundary
Content-Disposition: form-data; name="captureDate"

2025-03-03
--Boundary
Content-Disposition: form-data; name="satellite"

swot
--Boundary
Content-Disposition: form-data; name="imageType"

dom
--Boundary
Content-Disposition: form-data; name="regionCode"

320612001
--Boundary
Content-Disposition: form-data; name="boundaryFiles"; filename="boundary.shp"
Content-Type: application/octet-stream

< ./path/to/your/boundary.shp
--Boundary
Content-Disposition: form-data; name="boundaryFiles"; filename="boundary.dbf"
Content-Type: application/octet-stream

< ./path/to/your/boundary.dbf
--Boundary
Content-Disposition: form-data; name="boundaryFiles"; filename="boundary.prj"
Content-Type: application/octet-stream

< ./path/to/your/boundary.prj
--Boundary--

### 获取分页影像列表
GET http://localhost:8000/api/images?page=1&pageSize=10

### 根据ID获取影像
GET http://localhost:8000/api/images/1
